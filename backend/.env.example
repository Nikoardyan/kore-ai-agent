# Contoh file .env
# ⚠️  JANGAN commit file .env asli ke GitHub!
# Salin file ini: cp .env.example .env, lalu isi nilainya.

# API Key LLM (Groq pakai prefix gsk_, OpenAI pakai sk-)
LLM_API_KEY=gsk_GANTI_DENGAN_KEY_GROQ_KAMU

# URL database PostgreSQL
DATABASE_URL=postgresql://employee_agent:change-this-password@localhost:55432/employee_agent

# Model LLM utama
LLM_MODEL=llama-3.3-70b-versatile

# Model kecil khusus routing (opsional)
# LLM_ROUTER_MODEL=llama-3.1-8b-instant

# Origin frontend yang diizinkan (pisahkan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — wajib diisi pada production. Buat dengan: openssl rand -base64 48
# AUTH_SECRET=
APP_ENV=development

# Default aman: akun harus diprovisikan HR/admin. Hanya aktifkan untuk demo lokal.
ALLOW_SELF_REGISTRATION=false
